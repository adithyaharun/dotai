#!/usr/bin/env bash
# Manage ai-env secrets in the macOS login keychain (service "ai.<NAME>").
set -euo pipefail

usage() {
  cat <<'EOF'
usage:
  ai-secret set NAME          prompt for value (hidden), or read it from stdin when piped
  ai-secret get NAME          print value (for scripts; avoid in shared terminals)
  ai-secret rm NAME
  ai-secret ls                list stored names, never values
  ai-secret headers NAME=TPL  print JSON headers for MCP headersHelper, e.g.
                              ai-secret headers 'Authorization=Bearer {CONTEXT7_API_KEY}'
EOF
}

svc() { printf 'ai.%s' "$1"; }
read_secret() { security find-generic-password -a "$USER" -s "$(svc "$1")" -w 2>/dev/null; }

cmd="${1:-}"; shift || true
case "$cmd" in
  set)
    name="${1:?NAME required}"
    value=""
    if [ -t 0 ]; then
      printf 'value for %s: ' "$name" >&2
      IFS= read -rs value || true; echo >&2
    else
      IFS= read -r value || true
    fi
    # No TTY and empty stdin (e.g. Claude Code `!` commands): ask via a hidden macOS dialog.
    if [ -z "$value" ] && command -v osascript >/dev/null 2>&1; then
      value="$(osascript -e "text returned of (display dialog \"Value for $name\" default answer \"\" with hidden answer with title \"ai-secret\")" 2>/dev/null || true)"
    fi
    [ -n "$value" ] || { echo "error: empty value" >&2; exit 1; }
    security add-generic-password -U -a "$USER" -s "$(svc "$name")" -l "ai-env $name" -w "$value"
    echo "stored $name" >&2
    ;;
  get)
    read_secret "${1:?NAME required}" || { echo "error: $1 not found" >&2; exit 1; }
    ;;
  rm)
    security delete-generic-password -a "$USER" -s "$(svc "${1:?NAME required}")" >/dev/null 2>&1 \
      || { echo "error: $1 not found" >&2; exit 1; }
    echo "removed $1" >&2
    ;;
  ls)
    security dump-keychain 2>/dev/null \
      | sed -n 's/^ *"svce"<blob>="ai\.\(.*\)"$/\1/p' | sort -u
    ;;
  headers)
    out="{"; sep=""
    for pair in "$@"; do
      hname="${pair%%=*}"; tpl="${pair#*=}"
      while [[ "$tpl" =~ \{([A-Za-z_][A-Za-z0-9_]*)\} ]]; do
        ref="${BASH_REMATCH[1]}"
        val="${!ref:-}"
        [ -n "$val" ] || val="$(read_secret "$ref")" || { echo "error: $ref not found" >&2; exit 1; }
        tpl="${tpl//\{$ref\}/$val}"
      done
      tpl="${tpl//\\/\\\\}"; tpl="${tpl//\"/\\\"}"
      out="$out$sep\"$hname\":\"$tpl\""; sep=","
    done
    printf '%s}\n' "$out"
    ;;
  *) usage; [ -z "$cmd" ] || [ "$cmd" = -h ] || [ "$cmd" = --help ] || exit 1 ;;
esac
