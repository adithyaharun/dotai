#!/usr/bin/env bash
# Markdown changelog from Conventional Commits between two refs.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: git-changelog [--from REF] [--to REF] [--bump]
  --from   default: latest tag reachable from --to (all history if none)
  --to     default: HEAD
  --bump   print only the suggested semver bump: major | minor | patch | none
EOF
}

FROM=""; TO="HEAD"; BUMP=0
while [ $# -gt 0 ]; do
  case "$1" in
    --from) FROM="$2"; shift 2 ;;
    --to) TO="$2"; shift 2 ;;
    --bump) BUMP=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done

[ -n "$FROM" ] || FROM="$(git describe --tags --abbrev=0 "$TO" 2>/dev/null || true)"
RANGE="$TO"; [ -n "$FROM" ] && RANGE="$FROM..$TO"

breaking=""; feat=""; fix=""; perf=""; refactor=""; docs=""; other=""
level=0
US=$'\x1f'; RS=$'\x1e'

while IFS="$US" read -r -d "$RS" hash subject body; do
  hash="${hash#$'\n'}"
  [ -n "$hash" ] || continue
  case "$subject" in "chore(release)"*|"Merge "*) continue ;; esac
  type=""; desc="$subject"; bang=0
  if [[ "$subject" =~ ^([a-z]+)(\([^\)]*\))?(!)?:\ (.+)$ ]]; then
    type="${BASH_REMATCH[1]}"; scope="${BASH_REMATCH[2]}"; [ -n "${BASH_REMATCH[3]}" ] && bang=1
    desc="${BASH_REMATCH[4]}"
    scope="${scope#(}"; scope="${scope%)}"
    [ -n "$scope" ] && desc="**$scope:** $desc"
  fi
  case "$body" in *"BREAKING CHANGE"*|*"BREAKING-CHANGE"*) bang=1 ;; esac
  line="- $desc (${hash:0:7})"$'\n'
  if [ $bang = 1 ]; then breaking="$breaking$line"; level=3; fi
  case "$type" in
    feat) feat="$feat$line"; [ $level -lt 2 ] && level=2 ;;
    fix) fix="$fix$line"; [ $level -lt 1 ] && level=1 ;;
    perf) perf="$perf$line"; [ $level -lt 1 ] && level=1 ;;
    refactor) refactor="$refactor$line" ;;
    docs) docs="$docs$line" ;;
    *) [ $bang = 1 ] || other="$other$line" ;;
  esac
done < <(git log --no-merges --format="%H${US}%s${US}%b${RS}" "$RANGE")

if [ $BUMP = 1 ]; then
  case $level in 3) echo major ;; 2) echo minor ;; 1) echo patch ;; *) echo none ;; esac
  exit 0
fi

section() { [ -n "$2" ] && printf '### %s\n\n%s\n' "$1" "$2"; return 0; }
section "Breaking changes" "$breaking"
section "Features" "$feat"
section "Fixes" "$fix"
section "Performance" "$perf"
section "Refactoring" "$refactor"
section "Documentation" "$docs"
section "Other" "$other"
