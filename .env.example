# Copy to ~/.ai/.env (global) or <workspace>/.env (per workspace). Never commit the real file.
# Value forms:
#   KEY=plain-value
#   KEY=keychain:<name>     resolved by `security` from login keychain (service "ai.<name>")
#   KEY=op://vault/item/f   resolved by 1Password CLI, only when `op` is installed
CONTEXT7_API_KEY=keychain:CONTEXT7_API_KEY
TELEGRAM_BOT_TOKEN=keychain:TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=keychain:TELEGRAM_CHAT_ID
SENTRY_AUTH_TOKEN=keychain:SENTRY_AUTH_TOKEN
